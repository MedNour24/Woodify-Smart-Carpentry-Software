       <property name="styleSheet">
        <string notr="true">background-color: #2b2b2b;
border: none;

QLabel {
    color: #5c3317;
    background: transparent;
    font-weight: bold;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit {
    background-color: beige;
    border: 1px solid #a67c52;
    border-radius: 6px;
    padding: 4px;
    color: black;
}

QPushButton#btnValiderAjout {
    background-color: #8b5a2b;
    color: white;
    border: 2px solid #5c3a1e;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 14px;
    font-weight: bold;
}
QPushButton#btnValiderAjout:hover { background-color: #a06a3b; }
QPushButton#btnValiderAjout:pressed { background-color: #6f4422; }

QPushButton#btnAnnulerAjout {
    background-color: #c2a27a;
    color: #3b2a1a;
    border: 2px solid #8b6a3e;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 14px;
    font-weight: bold;
}
QPushButton#btnAnnulerAjout:hover { background-color: #d4b892; }
QPushButton#btnAnnulerAjout:pressed { background-color: #a88b63; }
</string>
