              <string notr="true">QWidget{
	background-color: white;
}

QLineEdit {
    border: 1px solid qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF4B2B, stop:1 #FF416C);
    border-radius: 5px;
    padding: 5px 15px;
    background-color: white;
    color: black;
    font-size: 12px;
}

QLineEdit:focus {
    border: 1px solid qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #32CD32, stop:1 #00FFFF);
}

QLineEdit:disabled {
    background-color: #F0F0F0;
    color: #A0A0A0;
}

QLineEdit:read-only {
    background-color: #F0F0F0;
    color: #A0A0A0;
}

QLineEdit::hover {
    border: 1px solid qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #BEBEBE, stop:1 #A4A4A4);
}

QLineEdit::selected {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF4B2B, stop:1 #FF416C);
    color: white;
}
QCheckBox {
    spacing: 10px;
	
	font: 12pt &quot;Open Sans Light&quot;;
}

QCheckBox::indicator {
    width: 35px;
    height: 35px;
}

QCheckBox::indicator:unchecked {
    image: url(:assets/icons/unchecked.png);
}

QCheckBox::indicator:checked {
    image: url(:assets/icons/checked.png);
}

QDateEdit {
    border: none;
    background-color: rgb(255, 255, 255);
    color: black;
    font-size: 16px;
    font-weight: normal;
    padding: 5px;
    border-radius: 5px;
}

QDateEdit::drop-down {
    background-color: transparent;
    image: url(:/assets/icons/cil-arrow-bottom_black.png);
    width: 20px;
    height: 20px;
}

QDateEdit::down-arrow {
    image: url(:/assets/icons/cil-arrow-bottom_black.png);
}

QDateEdit::up-arrow {
    image: url(:/assets/icons/cil-arrow-top_black.png);
}

QDateEdit::down-button {
    image: url(:/assets/icons/cil-arrow-bottom_black.png);
}

QDateEdit::up-button {
    image: url(:/assets/icons/cil-arrow-top_black.png);
}

QDateEdit::calendarWidget {
    border: none;
    background-color: rgb(255, 255, 255);
    color: black;
    font-size: 16px;
    font-weight: normal;
    padding: 5px;
    border-radius: 5px;
}

QDateEdit::section {
    background-color: transparent;
    border: none;
}
QPushButton {
    border: 1px solid qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF4B2B, stop:1 #FF416C);
    border-radius: 10px;
    padding: 5px 15px;
    background: #f9f9f9;
    color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF4B2B, stop:1 #FF416C);
    font-size: 12px;
}

QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF416C, stop:1 #FF4B2B);
	color: white;
}

QPushButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF4B2B, stop:1 #FF416C);
    border: 2px solid #FF416C;
    padding: 4px 14px 6px 16px;
}

QPushButton:disabled {
    border: 1px solid qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF4B2B, stop:1 #FF416C);
    border-radius: 10px;
    padding: 5px 15px;
    background: lightgray;
    color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF4B2B, stop:1 #FF416C);
    font-size: 12px;
}

QPushButton:checked {
    border: 1px solid qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF4B2B, stop:1 #FF416C);
    border-radius: 10px;
    padding: 5px 15px;
    background: red;
    color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF4B2B, stop:1 #FF416C);
    font-size: 12px;
}

</string>
