             <property name="styleSheet">
              <string notr="true">QWidget{
	background-color: white;
}

QLineEdit {
    border: none;
    border-radius: 5px;
    padding: 5px 15px;
    background-color: white;
    color: black;
    font-size: 12px;
}


QLineEdit:disabled {
    background-color: #F0F0F0;
    color: #A0A0A0;
}

QLineEdit:read-only {
    background-color: #F0F0F0;
    color: #A0A0A0;
}


QCheckBox {
    spacing: 10px;
	
	font: 12pt &quot;Open Sans Light&quot;;
}

QCheckBox::indicator {
    width: 35px;
    height: 35px;
}

QCheckBox::indicator:unchecked {
    image: url(:assets/icons/unchecked.png);
}

QCheckBox::indicator:checked {
    image: url(:assets/icons/checked.png);
}

QDateEdit {
    border: none;
    background-color: rgb(255, 255, 255);
    color: black;
    font-size: 16px;
    font-weight: normal;
    padding: 5px;
    border-radius: 5px;
}

QDateEdit::drop-down {
    background-color: transparent;
    image: url(:/assets/icons/cil-arrow-bottom_black.png);
    width: 20px;
    height: 20px;
}

QDateEdit::down-arrow {
    image: url(:/assets/icons/cil-arrow-bottom_black.png);
}

QDateEdit::up-arrow {
    image: url(:/assets/icons/cil-arrow-top_black.png);
}

QDateEdit::down-button {
    image: url(:/assets/icons/cil-arrow-bottom_black.png);
}

QDateEdit::up-button {
    image: url(:/assets/icons/cil-arrow-top_black.png);
}

QDateEdit::calendarWidget {
    border: none;
    background-color: rgb(255, 255, 255);
    color: black;
    font-size: 16px;
    font-weight: normal;
    padding: 5px;
    border-radius: 5px;
}

QDateEdit::section {
    background-color: transparent;
    border: none;
}
