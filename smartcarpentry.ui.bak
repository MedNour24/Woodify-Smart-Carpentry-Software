    border: none;
    padding: 5px 10px;
    font-size: 16px;
    font-weight: normal;
    color: black;
}

QPushButton:checked {
    border-bottom: 4px solid qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF4B2B, stop:1 #FF416C);
    border-right: none;
    border-top: none;
    color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF4B2B, stop:1 #FF416C);
    font-weight: 700;
}

QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #f2f2f2, stop:1 #e6e6e6);
}</string>
