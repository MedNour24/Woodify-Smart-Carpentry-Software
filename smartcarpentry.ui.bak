             <property name="styleSheet">
              <string notr="true">QLabel {
    color: #EDEDED;
    font-weight: 500;
}

/* MAIN WINDOW */
QWidget {
    background-color: rgb(35,35,36);
    color: #EAEAEA;
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;

}

/* GROUP BOX */
QGroupBox {
    border: 1px solid #3a3a3c;
    border-radius: 10px;
    margin-top: 12px;
    padding: 15px;
    background-color: #2b2b2d;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #4da3ff;
    font-weight: 600;
}

/* LABELS */
QLabel {
    color: #d6d6d6;
}

/* LINE EDIT */
QLineEdit {
    background-color: #1f1f21;
    border: 1px solid #3a3a3c;
    border-radius: 6px;
    padding: 6px;
    color: white;
}

QLineEdit:focus {
    border: 1px solid #4da3ff;
    background-color: #262628;
}

/* COMBO BOX */
QComboBox {
    background-color: #1f1f21;
    border: 1px solid #3a3a3c;
    border-radius: 6px;
    padding: 5px;
    color: white;
}

QComboBox:hover {
    border: 1px solid #4da3ff;
}

QComboBox::drop-down {
    border: none;
}

/* DATE EDIT */
QDateEdit {
    background-color: #1f1f21;
    border: 1px solid #3a3a3c;
    border-radius: 6px;
    padding: 5px;
    color: white;
}

QDateEdit:focus {
    border: 1px solid #4da3ff;
}

/* CHECKBOX */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    border: 1px solid #4da3ff;
    background: transparent;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #4da3ff;
    border: 1px solid #4da3ff;
    border-radius: 3px;
}

/* BUTTON */
QPushButton {
    background-color: #4da3ff;
    color: white;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #6db4ff;
}

QPushButton:pressed {
    background-color: #2f7de0;
}
</string>
